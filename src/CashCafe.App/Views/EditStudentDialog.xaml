<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CashCafe.App.Views.EditStudentDialog"
        Title="Edit student" Height="460" Width="440"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" />

        <CheckBox x:Name="ActiveBox" Content="Active (shown on the till)" Margin="0,4,0,16" />

        <TextBlock Text="OWN CREDIT LIMIT (kr, blank = use the café's normal −10 kr limit)"
                   Style="{StaticResource Label}" TextWrapping="Wrap" />
        <TextBox x:Name="LimitBox" FontSize="16" Margin="0,0,0,12" />

        <TextBlock Text="REASON FOR A CHANGED LIMIT" Style="{StaticResource Label}" />
        <TextBox x:Name="ReasonBox" FontSize="16" Margin="0,0,0,12" />

        <TextBlock x:Name="Problem" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0" MinWidth="100" />
            <Button Content="Save" IsDefault="True" MinWidth="120"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
