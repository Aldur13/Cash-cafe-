<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CashCafe.App.Views.CafeView"
             x:Name="Root">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Cash Café" FontSize="22" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Deposit  F4" Margin="0,0,8,0" Click="Deposit_Click" />
                <Button Content="Admin  F9" Click="Admin_Click" />
            </StackPanel>
        </Grid>

        <!-- Student -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="STUDENT" Style="{StaticResource Label}" />
                <TextBox x:Name="StudentBox" FontSize="18"
                         KeyDown="StudentBox_KeyDown"
                         Text="{Binding StudentQuery, UpdateSourceTrigger=PropertyChanged}" />

                <ListBox x:Name="StudentList" MaxHeight="220" Margin="0,4,0,0"
                         MouseDoubleClick="StudentList_Chosen"
                         ItemsSource="{Binding StudentMatches}"
                         Visibility="{Binding StudentQuery, Converter={StaticResource NotEmptyToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ClassName}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                           Text="{Binding Balance, Converter={StaticResource Money}}"
                                           Foreground="{Binding Balance, Converter={StaticResource BalanceBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding Student.DisplayName}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Student.ClassName}" Foreground="{StaticResource Muted}" />

                    <TextBlock Text="Balance" Style="{StaticResource Label}" Margin="0,12,0,0" />
                    <TextBlock FontSize="28" FontWeight="Bold"
                               Text="{Binding BalanceNow, Converter={StaticResource Money}}"
                               Foreground="{Binding BalanceNow, Converter={StaticResource BalanceBrush}}" />

                    <TextBlock Text="Can spend" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    <TextBlock FontSize="16" Text="{Binding CanSpend, Converter={StaticResource Money}}" />

                    <Border Background="#FFF6E5" Padding="8" CornerRadius="6" Margin="0,12,0,0"
                            Visibility="{Binding StudentNote, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock Text="{Binding StudentNote}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Items -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="THEY BUY" Style="{StaticResource Label}" />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LineNo}" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />

                                <ComboBox Grid.Column="1" Margin="0,0,8,0" FontSize="16" MinHeight="44"
                                          ItemsSource="{Binding DataContext.AvailableItems, ElementName=Root}"
                                          SelectedItem="{Binding Item, Mode=OneWay}"
                                          TextSearch.TextPath="Name"
                                          Tag="{Binding LineNo}"
                                          PreviewKeyDown="ItemCombo_PreviewKeyDown"
                                          SelectionChanged="ItemCombo_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Padding" Value="8,6" />
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="220">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                                           Foreground="{StaticResource Muted}"
                                                           Text="{Binding Price, Converter={StaticResource Money}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBox Grid.Column="2" Margin="0,0,8,0" TextAlignment="Center"
                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right"
                                           Text="{Binding UnitPrice, Converter={StaticResource Money}}" />

                                <TextBlock Grid.Column="4" VerticalAlignment="Center" TextAlignment="Right"
                                           FontWeight="SemiBold"
                                           Text="{Binding LineTotal, Converter={StaticResource Money}}" />

                                <Button Grid.Column="5" Content="✕" MinHeight="36" Padding="4"
                                        Click="RemoveRow_Click" Tag="{Binding LineNo}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Summary and Execute -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Items " Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ItemCount}" FontWeight="SemiBold" Margin="0,0,24,0" />
                        <TextBlock Text="Total " Foreground="{StaticResource Muted}" />
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   Text="{Binding Total, Converter={StaticResource Money}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Balance " Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding BalanceNow, Converter={StaticResource Money}}" />
                        <TextBlock Text="  →  " Foreground="{StaticResource Muted}" />
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding BalanceAfter, Converter={StaticResource Money}}"
                                   Foreground="{Binding BalanceAfter, Converter={StaticResource BalanceBrush}}" />
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="{Binding ExecuteBlockedReason}"
                               Foreground="{StaticResource Bad}"
                               Visibility="{Binding ExecuteBlockedReason, Converter={StaticResource NotEmptyToVisibility}}" />

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="620"
                               HorizontalAlignment="Left"
                               Text="{Binding Message}"
                               Foreground="{StaticResource Good}"
                               Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear  Esc" Margin="0,0,8,0" Command="{Binding ClearCommand}" />
                    <Button Content="EXECUTE  ⏎" Style="{StaticResource PrimaryButton}" MinWidth="180"
                            Command="{Binding CommitCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
