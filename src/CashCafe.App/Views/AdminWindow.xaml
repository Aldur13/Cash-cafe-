<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CashCafe.App.Views.AdminWindow"
        Title="Cash Café — Admin" Height="800" Width="1150"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#FFF6E5" Padding="12" CornerRadius="6" Margin="0,0,0,12"
                Visibility="{Binding DatabaseIsInASyncedFolder, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                       Text="The café database is inside a folder that Google Drive, OneDrive or Dropbox is syncing. Those clients copy files while they are open, which will corrupt the database sooner or later. Move it to C:\ProgramData\CashCafe and let the backups go to the cloud instead." />
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding Message}"
                   Visibility="{Binding Message, Converter={StaticResource NotEmptyToVisibility}}" />

        <TabControl>
            <TabItem Header="Items">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add item…" MinWidth="140" Margin="0,0,8,0" Click="AddItem_Click" />
                        <Button Content="Import menu from Excel…" MinWidth="190" Margin="0,0,8,0" Click="ImportMenu_Click" />
                        <Button Content="Export menu to Excel…" MinWidth="190" Margin="0,0,8,0" Click="ExportMenu_Click" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="Double-click a row to change its price, take it off sale, or remove it." />
                    </StackPanel>
                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                            <DataGridTextColumn Header="Price" Width="110"
                                                Binding="{Binding Price, Converter={StaticResource Money}}" />
                            <DataGridCheckBoxColumn Header="On sale" Binding="{Binding IsAvailable}" Width="80" />
                            <DataGridCheckBoxColumn Header="Archived" Binding="{Binding IsArchived}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Students">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add student…" MinWidth="140" Margin="0,0,8,0" Click="AddStudent_Click" />
                        <Button Content="Import from Excel…" MinWidth="160" Margin="0,0,8,0" Click="Import_Click" />
                        <Button Content="Export to Excel…" MinWidth="160" Margin="0,0,8,0" Click="Export_Click" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="Double-click a row to deactivate a student or set their own limit." />
                    </StackPanel>
                    <DataGrid x:Name="StudentsGrid" ItemsSource="{Binding Students}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MouseDoubleClick="StudentsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="80" />
                            <DataGridTextColumn Header="Balance" Width="120"
                                                Binding="{Binding Balance, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Own limit" Width="110"
                                                Binding="{Binding CreditLimit, Converter={StaticResource Money}}" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                            <DataGridCheckBoxColumn Header="Site login" Binding="{Binding HasLogin}" Width="80" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Deposits">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="New deposit…" MinWidth="140" Margin="0,0,8,0" Click="NewDeposit_Click" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                   Text="A parent Swished the café, or handed over cash — record it here." />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Deposits}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Width="150"
                                                Binding="{Binding OccurredUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                            <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="80" />
                            <DataGridTextColumn Header="Amount" Width="110"
                                                Binding="{Binding Amount, Converter={StaticResource Money}}" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="110" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="160" />
                            <DataGridTextColumn Header="By" Binding="{Binding Operator}" Width="100" />
                            <DataGridCheckBoxColumn Header="Cancelled" Binding="{Binding IsReversed}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Today">
                <ScrollViewer>
                    <StackPanel Margin="12">
                        <TextBlock Text="Today" Style="{StaticResource Heading}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="Sold" Style="{StaticResource Label}" />
                                <TextBlock FontSize="24" FontWeight="Bold"
                                           Text="{Binding Today.Sold, Converter={StaticResource Money}}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="Money in" Style="{StaticResource Label}" />
                                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource Good}"
                                           Text="{Binding Today.Received, Converter={StaticResource Money}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Purchases" Style="{StaticResource Label}" />
                                <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding Today.PurchaseCount}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="What sold" Style="{StaticResource Label}" />
                        <DataGrid ItemsSource="{Binding Today.ByItem}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="220" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Value" Width="120"
                                                    Binding="{Binding Value, Converter={StaticResource Money}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Who bought what" Style="{StaticResource Label}" />
                        <DataGrid ItemsSource="{Binding Today.ByStudent}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="220" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="*" />
                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="80" />
                                <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="70" />
                                <DataGridTextColumn Header="Spent" Width="120"
                                                    Binding="{Binding Value, Converter={StaticResource Money}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="In the red" Style="{StaticResource Label}" />
                        <DataGrid ItemsSource="{Binding InTheRed}" AutoGenerateColumns="False"
                                  IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Student" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="80" />
                                <DataGridTextColumn Header="Balance" Width="120"
                                                    Binding="{Binding Balance, Converter={StaticResource Money}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,12,12,8" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}"
                               Text="Everything that has happened, who did it and when. This cannot be edited or deleted from anywhere in the program." />
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Width="150"
                                                Binding="{Binding OccurredUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                            <DataGridTextColumn Header="Who" Binding="{Binding Actor}" Width="130" />
                            <DataGridTextColumn Header="What" Binding="{Binding Action}" Width="140" />
                            <DataGridTextColumn Header="Before" Binding="{Binding OldValue}" Width="110" />
                            <DataGridTextColumn Header="After" Binding="{Binding NewValue}" Width="110" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
