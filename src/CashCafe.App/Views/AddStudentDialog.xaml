<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CashCafe.App.Views.AddStudentDialog"
        Title="Add student" Height="380" Width="440"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock Text="Add student" Style="{StaticResource Heading}" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="Starts at a balance of 0 kr. Use Deposit on the till to add money once they exist here." />

        <TextBlock Text="FIRST NAME" Style="{StaticResource Label}" />
        <TextBox x:Name="FirstNameBox" FontSize="16" Margin="0,0,0,12" />

        <TextBlock Text="LAST NAME" Style="{StaticResource Label}" />
        <TextBox x:Name="LastNameBox" FontSize="16" Margin="0,0,0,12" />

        <TextBlock Text="CLASS (optional)" Style="{StaticResource Label}" />
        <TextBox x:Name="ClassBox" FontSize="16" />

        <TextBlock x:Name="Problem" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="100" />
            <Button Content="Add" IsDefault="True" MinWidth="120"
                    Style="{StaticResource PrimaryButton}" Click="Add_Click" />
        </StackPanel>
    </StackPanel>
</Window>
