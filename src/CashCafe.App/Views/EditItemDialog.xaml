<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CashCafe.App.Views.EditItemDialog"
        Title="Edit item" Height="480" Width="440"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Style="{StaticResource Heading}" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"
                   Text="Past sales keep the price they were sold at — changing it here only affects sales from now on." />

        <TextBlock Text="NEW PRICE (kr)" Style="{StaticResource Label}" />
        <TextBox x:Name="PriceBox" FontSize="16" Margin="0,0,0,12" />

        <TextBlock Text="REASON FOR THE PRICE CHANGE" Style="{StaticResource Label}" />
        <TextBox x:Name="ReasonBox" FontSize="16" Margin="0,0,0,12" />

        <CheckBox x:Name="AvailableBox" Content="On sale (shown on the till)" Margin="0,4,0,12" />

        <TextBlock x:Name="Problem" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Remove item…" Margin="0,0,8,0" MinWidth="120" Click="Remove_Click" />
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0" MinWidth="100" />
            <Button Content="Save" IsDefault="True" MinWidth="120"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
