<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CashCafe.App.Views"
        x:Class="CashCafe.App.Views.MainWindow"
        Title="Cash Café" Height="820" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
        <KeyBinding Key="F4" Command="{Binding DepositCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F9" Command="{Binding AdminCommand}" />
        <KeyBinding Key="F11" Command="{Binding FullScreenCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding CommitCommand}" />
    </Window.InputBindings>

    <Grid>
        <views:CafeView x:Name="Cafe" />
    </Grid>
</Window>
