<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CashCafe.App.Views.PinDialog"
        Title="Admin" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Text="Admin PIN" Style="{StaticResource Heading}" />
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   Text="The till keeps working whatever happens here." Margin="0,0,0,12" />

        <PasswordBox x:Name="PinBox" MinHeight="44" FontSize="20" MaxLength="12" />

        <TextBlock x:Name="Problem" Foreground="{StaticResource Bad}" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="100" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="100"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
